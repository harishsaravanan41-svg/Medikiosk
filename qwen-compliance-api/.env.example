# Server Authentication Key
QWEN_API_KEY=qwen_secret_key_12345
API_KEY=qwen_secret_key_12345

# Server Endpoint URL
QWEN_API_URL=http://localhost:10000/v1/chat

# Path to directory containing fine-tuned model adapter files
MODEL_PATH=.

# Original base model name on Hugging Face
BASE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct

# Display model identifier in /health endpoint
MODEL_NAME=qwen-compliance

# Server Host and Port
HOST=0.0.0.0
PORT=10000

# CORS Allowed Origins
ALLOWED_ORIGINS=*
