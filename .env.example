# MediKiosk Environment Configuration

# Flask Server Config
PORT=5000
HOST=0.0.0.0
DEBUG=True
SECRET_KEY=medikiosk-secure-random-key-2026

# Qwen LLM Configuration
# Modes: "local_endpoint" (Ollama/LM Studio/vLLM), "dashscope", "huggingface", "openai_compatible"
QWEN_MODE=local_endpoint
QWEN_API_BASE=http://localhost:11434/v1
QWEN_API_KEY=
QWEN_MODEL=qwen2.5:1.5b

# STT Configuration (Whisper)
# Models: "tiny", "base", "small", "medium"
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# TTS Configuration (Piper / Fallback)
# Engines: "piper", "gtts", "auto"
TTS_ENGINE=auto
PIPER_VOICE_MODEL=en_US-lessac-medium
PIPER_EXE_PATH=piper

# Storage Paths
DATA_DIR=data
AUDIO_CACHE_DIR=static/audio
